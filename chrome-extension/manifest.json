{
  "manifest_version": 3,
  "name": "Argus Personal Tab Context",
  "version": "0.1.1",
  "description": "Explicitly share the current Chrome tab with your local Argus AI editor.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4175/*"],
  "action": {
    "default_title": "Share tab with Argus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
